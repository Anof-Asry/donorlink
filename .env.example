# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/donorLink

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRES_IN=1d

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" in production to enable secure cookies and other prod guards
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
